{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM":  "D:/ProgramData/Qt/Tools/Ninja/ninja.exe",
                "CMAKE_PREFIX_PATH":   "D:/ProgramData/Qt/6.10.2/mingw_64",
                "CMAKE_C_COMPILER":    "D:/ProgramData/Qt/Tools/mingw1310_64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER":  "D:/ProgramData/Qt/Tools/mingw1310_64/bin/g++.exe"
            },
            "environment": {
                "PATH": "D:/ProgramData/Qt/6.10.2/mingw_64/bin;D:/ProgramData/Qt/Tools/mingw1310_64/bin;D:/ProgramData/Qt/Tools/Ninja;$penv{PATH}"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows x64 Release (MinGW)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows x64 Debug (MinGW)",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        }
    ],
    "testPresets": [
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}