/*
 * NC-KTV PRO — Professional Karaoke Studio
 * Dark Theme Stylesheet (Qt Style Sheet)
 *
 * Remodeled to match NC-KTV Pro UI Prototype
 * Color Palette: Deep space dark with blue/violet accent system
 */

/* ─── Global ─────────────────────────────────────────────────────────────── */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
}

/* ─── Main Window ────────────────────────────────────────────────────────── */

QMainWindow {
    background-color: #0b101b;
}

QMainWindow::separator {
    background: #1e293b;
    width: 2px;
    height: 2px;
}

/* ─── Menu Bar ───────────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #0f172a;
    color: #94a3b8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    font-size: 13px;
}

QMenuBar::item {
    padding: 8px 14px;
    border-radius: 6px;
    color: #94a3b8;
    font-weight: 500;
}

QMenuBar::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: #ffffff;
}

QMenu {
    background-color: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 16px;
    border-radius: 6px;
    color: #94a3b8;
}

QMenu::item:selected {
    background-color: rgba(59, 130, 246, 0.2);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.05);
    margin: 4px 8px;
}

/* ─── Buttons ────────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #334155;
    border-color: rgba(59, 130, 246, 0.3);
}

QPushButton:pressed {
    background-color: #1a2332;
}

QPushButton:disabled {
    background-color: #0f172a;
    color: #475569;
    border-color: rgba(255, 255, 255, 0.03);
}

QPushButton#primary,
QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #3b82f6, stop:1 #8b5cf6);
    color: white;
    border: none;
    font-weight: bold;
    border-radius: 10px;
}

QPushButton#primary:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #60a5fa, stop:1 #a78bfa);
}

QPushButton#destructive {
    background-color: #dc2626;
    color: white;
    border: none;
}

QPushButton#destructive:hover {
    background-color: #ef4444;
}

/* ─── Input Fields ───────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #1a2333;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #3b82f6;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #3b82f6;
    background-color: rgba(59, 130, 246, 0.05);
}

/* ─── Combo Box ──────────────────────────────────────────────────────────── */

QComboBox {
    background-color: #1e293b;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: rgba(59, 130, 246, 0.3);
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: rgba(15, 23, 42, 0.95);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    selection-background-color: rgba(59, 130, 246, 0.25);
    padding: 4px;
}

/* ─── Tabs ───────────────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #111827;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #94a3b8;
    padding: 12px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 600;
    font-size: 13px;
}

QTabBar::tab:hover {
    color: #e2e8f0;
}

QTabBar::tab:selected {
    color: #3b82f6;
    border-bottom: 2px solid #3b82f6;
}

/* ─── Scroll Bars ────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(59, 130, 246, 0.3);
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3b82f6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(59, 130, 246, 0.3);
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #3b82f6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ─── Sliders ────────────────────────────────────────────────────────────── */

QSlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.05);
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #3b82f6;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #60a5fa;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #8b5cf6);
    border-radius: 3px;
}

/* ─── Progress Bar ───────────────────────────────────────────────────────── */

QProgressBar {
    background-color: rgba(255, 255, 255, 0.05);
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    height: 10px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #3b82f6, stop:1 #8b5cf6);
    border-radius: 6px;
}

/* ─── Status Bar ─────────────────────────────────────────────────────────── */

QStatusBar {
    background-color: #0f172a;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 11px;
    font-weight: 600;
}

/* ─── Group Box ──────────────────────────────────────────────────────────── */

QGroupBox {
    background-color: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    margin-top: 14px;
    padding-top: 18px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}

/* ─── List / Tree / Table ────────────────────────────────────────────────── */

QListWidget, QTreeWidget, QTableWidget {
    background-color: #111827;
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    alternate-background-color: #0f172a;
}

QListWidget::item:selected,
QTreeWidget::item:selected,
QTableWidget::item:selected {
    background-color: rgba(59, 130, 246, 0.15);
    color: #ffffff;
}

QListWidget::item:hover,
QTreeWidget::item:hover {
    background-color: rgba(59, 130, 246, 0.08);
}

QHeaderView::section {
    background-color: #111827;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 8px 12px;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.5px;
}

/* ─── Splitter ───────────────────────────────────────────────────────────── */

QSplitter::handle {
    background: #1e293b;
}

QSplitter::handle:hover {
    background: #3b82f6;
}

/* ─── ToolTip ────────────────────────────────────────────────────────────── */

QToolTip {
    background-color: rgba(15, 23, 42, 0.95);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ─── Dialog ─────────────────────────────────────────────────────────────── */

QDialog {
    background-color: #121827;
}

/* ─── CheckBox / RadioButton ─────────────────────────────────────────────── */

QCheckBox, QRadioButton {
    color: #e2e8f0;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    background: transparent;
}

QCheckBox::indicator:checked {
    border: 2px solid #3b82f6;
    border-radius: 4px;
    background-color: #3b82f6;
}

QRadioButton::indicator:unchecked {
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 9px;
    background: transparent;
}

QRadioButton::indicator:checked {
    border: 2px solid #3b82f6;
    border-radius: 9px;
    background-color: #3b82f6;
}

/* ─── Tool Bar ───────────────────────────────────────────────────────────── */

QToolBar {
    background-color: #0f172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 4px 12px;
    spacing: 6px;
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 6px 12px;
    color: #94a3b8;
    font-weight: 500;
}

QToolBar QToolButton:hover {
    background: rgba(59, 130, 246, 0.1);
    color: #e2e8f0;
}

QToolBar QToolButton:pressed {
    background: rgba(59, 130, 246, 0.2);
}

QToolBar::separator {
    width: 1px;
    background: rgba(255, 255, 255, 0.05);
    margin: 4px 6px;
}

/* ─── Dock Widget ────────────────────────────────────────────────────────── */

QDockWidget {
    background-color: #111827;
    border: 1px solid rgba(255, 255, 255, 0.05);
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #0f172a;
    padding: 8px 12px;
    font-weight: 800;
    font-size: 11px;
    color: #94a3b8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* ─── Label Specializations ──────────────────────────────────────────────── */

QLabel#proTitle {
    font-family: "Segoe UI", "Outfit", sans-serif;
    font-size: 36px;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: -1px;
}

QLabel#proBadge {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: #3b82f6;
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 12px;
}

QLabel#proSubtitle {
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.6;
}

QLabel#sectionLabel {
    font-size: 11px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 1.5px;
}

QLabel#accentValue {
    color: #3b82f6;
    font-weight: 700;
    font-size: 15px;
}
