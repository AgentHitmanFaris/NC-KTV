<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="logo.ico" />
    <Resource Include="logo.png" />
  </ItemGroup>

  <!-- Copy native dependencies from C++ build directory -->
  <Target Name="CopyNativeDlls" AfterTargets="AfterBuild;Publish">
    <PropertyGroup>
      <DestDir>$(TargetDir)</DestDir>
      <DestDir Condition="'$(PublishDir)' != ''">$(PublishDir)</DestDir>
    </PropertyGroup>
    <Message Text="Copying Native DLLs and Qt Plugins from C++ build directory to $(DestDir)..." Importance="High" />
    <ItemGroup>
      <BridgeDll Include="$(ProjectDir)..\build\ncktv_bridge.dll" />
      <OnnxDll Include="$(ProjectDir)..\build\onnxruntime.dll" />
      <QtDlls Include="$(ProjectDir)..\build\Qt6*.dll" />
      <FFmpegDlls Include="$(ProjectDir)..\build\av*.dll" />
      <FFmpegDlls2 Include="$(ProjectDir)..\build\sw*.dll" />
      <FFmpegDlls3 Include="$(ProjectDir)..\build\post*.dll" />
      <FFmpegExe Include="$(ProjectDir)..\build\ffmpeg.exe" />
      <FFmpegExe2 Include="$(ProjectDir)..\build\ffprobe.exe" />
      <ConfigYaml Include="$(ProjectDir)..\config.yaml" />
      <PythonBridge Include="$(ProjectDir)..\scripts\python_bridge.py" />
      <PythonReqs Include="$(ProjectDir)..\scripts\requirements.txt" />
      
      <!-- Qt Plugins recursively -->
      <QtPlatformPlugins Include="$(ProjectDir)..\build\platforms\**\*.*" />
      <QtStylePlugins Include="$(ProjectDir)..\build\styles\**\*.*" />
      <QtMultimediaPlugins Include="$(ProjectDir)..\build\multimedia\**\*.*" />
      <QtImagePlugins Include="$(ProjectDir)..\build\imageformats\**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="@(BridgeDll)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OnnxDll)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtDlls)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegDlls)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegDlls2)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegDlls3)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegExe)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FFmpegExe2)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ConfigYaml)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PythonBridge)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PythonReqs)" DestinationFolder="$(DestDir)" SkipUnchangedFiles="true" />
    
    <!-- Copy plugins preserving subdirectories -->
    <Copy SourceFiles="@(QtPlatformPlugins)" DestinationFolder="$(DestDir)platforms\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtStylePlugins)" DestinationFolder="$(DestDir)styles\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtMultimediaPlugins)" DestinationFolder="$(DestDir)multimedia\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtImagePlugins)" DestinationFolder="$(DestDir)imageformats\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
